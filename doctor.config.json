{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "__mocks__/**",
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "tools/oxlint/anti-slop/**",
      "src/components/chat/components/chat-message/__fixtures__/seven-tv-paints.fixture.ts"
    ],
    "overrides": [
      {
        "files": ["package.json"],
        "rules": ["deslop/unused-dependency", "deslop/unused-dev-dependency"]
      },
      {
        "files": [
          "src/screens/preferences/blocked-terms-screen.tsx",
          "src/screens/preferences/chat-highlights-screen.tsx",
          "src/screens/preferences/saved-phrases-screen.tsx"
        ],
        "rules": ["react-hooks-js/immutability"]
      },
      {
        "files": ["src/components/chat/hooks/use-seventv-ws.ts"],
        "rules": ["react-hooks-js/purity", "react-doctor/effect-needs-cleanup"]
      },
      {
        "files": ["src/hooks/ws/use-websocket.ts"],
        "rules": ["react-doctor/effect-needs-cleanup"]
      },
      {
        "files": ["src/services/twitch-chat-service.ts"],
        "rules": ["react-hooks-js/purity"]
      },
      {
        "files": [
          "src/components/chat/hooks/use-chat-messages.ts",
          "src/components/stream-player/hooks/use-player-bridge.ts",
          "src/components/stream-player/hooks/use-stream-player-source.ts",
          "src/components/chat/components/chat-message/renderers/emote-action-sheet.tsx",
          "src/services/twitch-chat-service.ts"
        ],
        "rules": ["react-hooks-js/refs"]
      },
      {
        "files": ["src/hooks/use-lazy-ref.ts"],
        "rules": ["react-doctor/no-ref-current-in-render"]
      },
      {
        "files": ["src/screens/stream/hooks/use-live-stream-orientation.ts"],
        "rules": ["react-hooks-js/set-state-in-effect"]
      },
      {
        "files": ["src/services/twitch-ws-service.ts"],
        "rules": [
          "react-doctor/async-await-in-loop",
          "react-doctor/js-set-map-lookups"
        ]
      },
      {
        "files": ["src/utils/string/format-view-count.ts"],
        "rules": ["react-doctor/js-hoist-intl"]
      },
      {
        "files": ["src/screens/dev-tools/synced-emotes-screen.tsx"],
        "rules": ["react-doctor/rn-no-scrollview-mapped-list"]
      },
      {
        "files": ["src/screens/dev-tools/image-benchmark-screen.tsx"],
        "rules": ["react-doctor/no-set-state-after-await-in-effect"]
      }
    ]
  },
  "rules": {
    "react-doctor/react-compiler-no-manual-memoization": "off",
    "react-doctor/rn-no-raw-text": "warn",
    "deslop/unused-export": "off",
    "deslop/unused-file": "off"
  }
}
