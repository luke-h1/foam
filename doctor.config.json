{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "__mocks__/**",
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "tools/oxlint/anti-slop/**",
      "src/components/Chat/components/ChatMessage/__fixtures__/sevenTvPaints.fixture.ts"
    ],
    "overrides": [
      {
        "files": ["package.json"],
        "rules": ["deslop/unused-dependency", "deslop/unused-dev-dependency"]
      },
      {
        "files": [
          "src/screens/Preferences/BlockedTermsScreen.tsx",
          "src/screens/Preferences/ChatHighlightsScreen.tsx",
          "src/screens/Preferences/SavedPhrasesScreen.tsx"
        ],
        "rules": ["react-hooks-js/immutability"]
      },
      {
        "files": ["src/components/Chat/hooks/useSeventvWs.ts"],
        "rules": ["react-hooks-js/purity", "react-doctor/effect-needs-cleanup"]
      },
      {
        "files": ["src/services/twitch-chat-service.ts"],
        "rules": ["react-hooks-js/purity"]
      },
      {
        "files": [
          "src/components/Chat/hooks/useChatMessages.ts",
          "src/components/StreamPlayer/usePlayerBridge.ts",
          "src/components/Chat/components/ChatMessage/renderers/EmoteActionSheet.tsx"
        ],
        "rules": ["react-hooks-js/refs"]
      },
      {
        "files": ["src/hooks/useLazyRef.ts"],
        "rules": ["react-doctor/no-ref-current-in-render"]
      },
      {
        "files": ["src/services/twitch-ws-service.ts"],
        "rules": [
          "react-doctor/async-await-in-loop",
          "react-doctor/js-set-map-lookups"
        ]
      },
      {
        "files": ["src/utils/string/formatViewCount.ts"],
        "rules": ["react-doctor/js-hoist-intl"]
      },
      {
        "files": ["src/screens/DevTools/SyncedEmotesScreen.tsx"],
        "rules": ["react-doctor/rn-no-scrollview-mapped-list"]
      },
      {
        "files": ["src/screens/DevTools/ImageBenchmarkScreen.tsx"],
        "rules": ["react-doctor/no-set-state-after-await-in-effect"]
      }
    ]
  },
  "rules": {
    "react-doctor/react-compiler-no-manual-memoization": "off",
    "react-doctor/rn-no-raw-text": "warn",
    "deslop/unused-export": "off",
    "deslop/unused-file": "off"
  }
}
