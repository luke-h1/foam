diff --git a/ios/TrueSheetView.mm b/ios/TrueSheetView.mm
index 2ce79bde16c8c2e1751bbcca7a032b8a4d266321..3f2a946df6755bbfda13cac54c9dc66f23e1a319 100644
--- a/ios/TrueSheetView.mm
+++ b/ios/TrueSheetView.mm
@@ -153,6 +153,16 @@ using namespace facebook::react;
 
 #pragma mark - RCTComponentViewProtocol
 
+/**
+ * Opt out of Fabric view recycling. Dismissal of a still-presented sheet on teardown only
+ * happens in `dealloc` - `prepareForRecycle` just resets flags - and the recycle pool defers
+ * `dealloc` indefinitely, so unmounting while presented strands the sheet on screen
+ * (lodev09/react-native-true-sheet#395, closed as wontfix).
+ */
++ (BOOL)shouldBeRecycled {
+  return NO;
+}
+
 + (ComponentDescriptorProvider)componentDescriptorProvider {
   return concreteComponentDescriptorProvider<TrueSheetViewComponentDescriptor>();
 }
