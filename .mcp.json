{
  "mcpServers": {
    "appllama": {
      "type": "http",
      "url": "https://mcp.appllama.io/mcp"
    },
    "runway": {
      "type": "http",
      "url": "https://mcp.runway.team",
      "headers": {
        "Authorization": "Bearer ${RUNWAY_API_KEY:-}"
      }
    },
    "appeeky": {
      "type": "http",
      "url": "https://mcp.appeeky.com/mcp",
      "headers": {
        "X-API-Key": "${APPEEKY_API_KEY:-}"
      }
    }
  }
}
