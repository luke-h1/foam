{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "jsxSingleQuote": true,
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    ".agent-device",
    ".agents",
    ".next",
    "public",
    "build",
    "build-artifacts",
    "coverage",
    "traces",
    ".jest-cache",
    ".reassure",
    ".fingerprint-cache",
    ".zed-jar-cache",
    "workspace.json",
    ".expo",
    "android",
    "ios",
    "dist",
    "generated",
    "bun.lock",
    "player-website/.astro",
    "player-website/dist",
    "src/graphql/generated",
    "docs/profiles",
    ".cache",
    "tools/oxlint/anti-slop",
    ".rnstorybook/storybook.requires.ts"
  ]
}
